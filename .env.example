# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web App Configuration (for GitHub Pages / custom hosting)
# Leave blank inside AI Studio if using firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# Optional comma-separated list of authorized Admin emails
VITE_ADMIN_EMAILS="azfar.mazumder@gmail.com,info.globaleduexp@gmail.com"

# Optional email notification settings for consultation bookings:
# Option A: Resend API (https://resend.com)
RESEND_API_KEY=""
CONSULTANCY_NOTIFY_EMAIL="info.globaleduexp@gmail.com"

# Option B: Formspree endpoint (https://formspree.io)
FORMSPREE_ENDPOINT=""
