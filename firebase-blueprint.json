{
  "entities": {
    "Consultation": {
      "title": "Consultation",
      "description": "Prospective international student consultation booking and inquiry record.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Student full legal name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "description": "Student contact email address."
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30,
          "pattern": "^\\+?[0-9\\s\\-()]{7,30}$",
          "description": "Phone or WhatsApp contact number with country code."
        },
        "destination": {
          "type": "string",
          "enum": [
            "Malaysia",
            "Europe (Germany / EU)",
            "United Kingdom",
            "East Asia (Japan / South Korea)",
            "Canada / USA / Australia",
            "Rest of the World",
            "Undecided / Need Guidance"
          ],
          "description": "Preferred study destination."
        },
        "degreeLevel": {
          "type": "string",
          "enum": [
            "Diploma",
            "Foundation",
            "Undergraduate",
            "Masters"
          ],
          "description": "Desired degree level."
        },
        "preferredDateTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80,
          "description": "Preferred consultation date and time window."
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1500,
          "description": "Academic background, target intake, and specific questions."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "scheduled", "completed", "archived"],
          "description": "Counseling workflow status."
        },
        "adminNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000,
          "description": "Internal counselor notes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "fullName",
        "email",
        "phone",
        "destination",
        "degreeLevel",
        "preferredDateTime",
        "message",
        "status",
        "adminNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized education consultancy staff member allowed to review bookings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Verified staff email."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "counselor"],
          "description": "Staff role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record creation timestamp."
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/consultations/{consultationId}": {
      "schema": { "$ref": "#/entities/Consultation" },
      "description": "Consultation booking records submitted by prospective students and managed by verified consultants."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized consultancy administrators for Admin Dashboard access."
    }
  }
}
